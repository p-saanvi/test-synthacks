# Copy this file to .env and fill in your own values.
# See config.py and qwen_triage.py for how these are used.

# --- Required for real symptom analysis (qwen_triage.py, via OpenRouter) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional overrides — defaults shown
# TRIAGE_MODEL=qwen/qwen3-14b
# VISION_MODEL=qwen/qwen2.5-vl-72b-instruct

# --- Hospital contact simulation (config.py) ---
# HOSPITAL_CONTACT_MAX_RETRIES=3
# HOSPITAL_SIMULATED_FAILURES_BEFORE_SUCCESS=1

# --- Shared database (config.py) ---
# Defaults to server/health360.db (shared with the Health 360 Node.js app) —
# only override this if you really want a separate database.
# DATABASE_PATH=

# --- Flask app (config.py) ---
# FLASK_SECRET_KEY=dev-secret-key-change-me
# FLASK_DEBUG=true
# FLASK_PORT=5000

# Where to send someone who hasn't signed up / finished onboarding yet.
# HEALTH360_URL=http://localhost:4000

# --- llm_interface_openrouter.py (alternate reference implementation, not
# wired into app.py by default) ---
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openai/gpt-oss-20b:free
# OPENROUTER_SITE_URL=
# OPENROUTER_SITE_NAME=AI Health Decision Support System
# LLM_MAX_RETRIES=3
# LLM_TEMPERATURE=0.2
